{
  "name": "retrosheet-service",
  "version": "0.1.0",
  "private": true,
  "description": "GraphQL service over Retrosheet historical baseball data, backed by PostgreSQL.",
  "license": "BSD-3-Clause",
  "author": "Syd Polk",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "etl": "tsx src/etl/run.ts",
    "etl:built": "node dist/etl/run.js",
    "mcp": "tsx src/mcp/index.ts",
    "mcp:built": "node dist/mcp/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:plays": "tsx src/tools/validate-plays.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "csv-parse": "^5.6.0",
    "express": "^5.2.1",
    "pg": "^8.13.1",
    "pg-copy-streams": "^6.0.6",
    "postgraphile": "^5.1.4",
    "postgraphile-plugin-connection-filter": "^3.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.10"
  }
}
