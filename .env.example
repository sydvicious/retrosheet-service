# Copy to .env for local (non-Docker) runs. Docker Compose sets its own values.

# Postgres connection used by the API and the ETL loader.
DATABASE_URL=postgres://retrosheet:retrosheet@localhost:5432/retrosheet

# Schema the mart lives in (must match sql/schema.sql; leave as "retrosheet").
PG_SCHEMA=retrosheet

# Port the GraphQL server listens on. (Avoid 5000 on macOS — the AirPlay
# Receiver in Control Center listens there by default.)
PORT=5050

# Where the Retrosheet source data lives.
#   On this Mac dev machine, point it at your local clone:
#     RETROSHEET_DIR=/Users/jazzman/Documents/Baseball/retrosheet/retrosheet
#   Elsewhere, run scripts/fetch-data.sh to clone into ./data (the default).
RETROSHEET_DIR=./data
