#
# systemd unit for a Linux installation of retrosheet-service (e.g. warehouse).
# Brings up db, api and mcp with Docker Compose at boot and takes them down at
# shutdown. It never runs the loader, so the data in the pgdata volume is kept.
#
# Install (from the repo directory; WorkingDirectory must be the checkout):
#   sudo cp deploy/retrosheet.service /etc/systemd/system/
#   sudo sed -i "s|^WorkingDirectory=.*|WorkingDirectory=$PWD|" /etc/systemd/system/retrosheet.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now retrosheet
#
# Then: systemctl status retrosheet, sudo systemctl stop retrosheet,
# sudo systemctl start retrosheet, journalctl -u retrosheet.

[Unit]
Description=Retrosheet GraphQL API and MCP server (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The checkout of sydvicious/retrosheet-service. Edit, or use the sed line above.
WorkingDirectory=/opt/retrosheet-service
ExecStart=/usr/bin/docker compose up -d db api mcp
ExecStop=/usr/bin/docker compose down
# A first start on a fresh host builds the images, which can take minutes.
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
